# Plantilla de variables de entorno. Copiar a .env y rellenar.
# El archivo .env está en .gitignore: NUNCA se sube al repositorio.
# Este archivo SÍ se sube: solo contiene nombres y valores de ejemplo, nunca claves reales.
# En Azure, estos valores van como secretos de la Container App o en Key Vault.

# --- Base de datos (PostgreSQL 16 con pgvector) ---
# Local (fuera de Docker). Dentro de docker-compose se sobrescribe con el host "db".
DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/licitaciones
# Azure Database for PostgreSQL Flexible Server (requiere la extensión "vector" habilitada):
# DB_CONNECTION_STRING=postgresql://<usuario>:<clave>@<servidor>.postgres.database.azure.com:5432/licitaciones?sslmode=require

# --- API ---
API_URL=http://localhost:8000
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:8080

# --- Identidad ---
# local: usuarios propios con correo y contraseña, roles y sesiones con expiración (recomendado).
# desarrollo: la API acepta solo API_TOKEN_DESARROLLO, sin usuarios (pruebas locales; NUNCA en Azure).
# oidc: inicio de sesión solo con la cuenta institucional en Entra ID (DA-10). Los usuarios los sigue
#       creando el administrador en Licita, sin contraseña; el rol y el estado se deciden aquí.
# local + OIDC_AUTHORITY, OIDC_CLIENT_ID y OIDC_CLIENT_SECRET: la pantalla ofrece ambas opciones
#       (cuenta institucional y usuario de Licita con contraseña).
AUTH_MODE=local
# Solo con AUTH_MODE=desarrollo. Genere un valor aleatorio largo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN_DESARROLLO=
# Token que la webui envía a la API en modo desarrollo: el MISMO valor de API_TOKEN_DESARROLLO.
API_TOKEN=

# --- Sesiones (AUTH_MODE=local u oidc) ---
# Clave de al menos 32 caracteres con que la API firma los tokens de sesión (generar como arriba).
SESION_SECRETO=
# Vigencia máxima de una sesión y cierre por inactividad (minutos).
SESION_DURACION_MIN=480
SESION_INACTIVIDAD_MIN=30
# Bloqueo temporal tras intentos fallidos de inicio de sesión.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=5
# Firma la cookie de la interfaz web (generar como arriba).
WEBUI_STORAGE_SECRET=
# Administrador inicial: se crea al arrancar la API solo si no hay ningún usuario.
# Con AUTH_MODE=oidc basta ADMIN_EMAIL (su cuenta institucional): si ese correo no está registrado
# se registra como administrador al arrancar, aunque ya haya usuarios. ADMIN_PASSWORD no se usa.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@licita.local
ADMIN_PASSWORD=

# Solo con AUTH_MODE=oidc (App Registration de Entra ID, ver GUIA_PRUEBAS.md):
OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<application-client-id>
# Secreto del cliente (Certificados y secretos). En Azure, desde Key Vault.
OIDC_CLIENT_SECRET=
# Vacía = WEBUI_URL + /auth/callback. Debe estar registrada igual en el App Registration.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# true: cerrar sesión en Licita también la cierra en Entra ID.
OIDC_CERRAR_EN_PROVEEDOR=true

# --- Cola de trabajo ---
# Vacía = la API ejecuta el análisis en su propio proceso (recomendado para pruebas locales).
# Con valor = la API publica en Azure Service Bus y worker_analysis consume la cola.
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=analisis-licitaciones

# --- Modelo de lenguaje (agentes del worker de análisis) ---
# El deployment de chat debe soportar Structured Outputs (p. ej. gpt-4o-mini 2024-07-18
# o gpt-5-mini) y la versión de API debe ser 2024-08-01-preview o posterior.
# Use la raíz del recurso (https://<recurso>.openai.azure.com o
# https://<recurso>.services.ai.azure.com), NO el endpoint del proyecto de Foundry
# (…/api/projects/<proyecto>): con ese Azure responde "API version not supported".
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Debe producir vectores de 1536 dimensiones (text-embedding-3-small). Si no existe,
# el portafolio se busca por texto completo.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
LLM_TIMEOUT_S=120
# Llamadas simultáneas al modelo por tarea (fragmentos y requisitos, RNF-001). 1 = en serie.
ANALISIS_PARALELISMO=4
# 0 = respuestas reproducibles. Vacía = no se envía. Con gpt-5*, o1, o3 y o4 se omite siempre
# (solo admiten la predeterminada).
LLM_TEMPERATURA=0

# --- Pasarela del modelo (DA-07) ---
# Tokens (entrada + salida) por mes calendario (RF-028, ASR-13). 0 = sin límite.
CUOTA_TOKENS_PERIODO=5000000
CUOTA_ALERTA_PORCENTAJE=80
# Términos que nunca salen hacia el proveedor (ASR-05), separados por coma: nombre de la fábrica,
# clientes, personas. Correos, URL, NIT y teléfonos se anonimizan siempre.
ANONIMIZACION_TERMINOS=
# Disyuntor (ASR-07): fallas transitorias seguidas que lo abren y segundos que permanece abierto.
DISYUNTOR_FALLAS=5
DISYUNTOR_ESPERA_S=60
# Igual al MaxDeliveryCount de la cola: al llegar, el mensaje pasa a fallidos y la tarea a Fallida.
SERVICE_BUS_MAX_ENTREGAS=10

# --- SECOP II / Datos Abiertos ---
SECOP_BASE_URL=https://www.datos.gov.co/resource/p6dx-8zbt.json
# Token de aplicación de Socrata (datos.gov.co > Perfil > Developer settings). Amplía la cuota.
SOCRATA_APP_TOKEN=
# Secreto del token: no se usa para lecturas.
SOCRATA_APP_SECRET=
# Archivos publicados de cada proceso (RF-011).
SECOP_DOCUMENTOS_URL=https://www.datos.gov.co/resource/dmgg-8hin.json
# true: se pide cada archivo al enlace publicado; lo que SECOP II no entregue queda como
# faltante para la carga manual (RF-022). false: todos quedan como faltantes.
SECOP_DESCARGAR_DOCUMENTOS=true

# --- Expediente documental (RF-021, RF-022) ---
EXPEDIENTES_DIR=data/expedientes
# Tamaño máximo de cada archivo, descargado o cargado a mano.
EXPEDIENTE_MAX_MB=25

# --- Vigilancia automática de SECOP II ---
# Días hacia atrás que revisa cada barrido y afinidad mínima (0-100) para crear una alerta.
VIGILANCIA_DIAS=7
VIGILANCIA_UMBRAL=30
# 0 = el worker hace un barrido y termina; >0 = repite cada N minutos.
VIGILANCIA_INTERVALO_MIN=0
VIGILANCIA_MAX_PROCESOS=500
# Horas sin una sincronización exitosa tras las cuales la lista se marca como desactualizada.
VIGILANCIA_VIGENCIA_HORAS=26

# --- Notificaciones por correo (RF-016, RF-017, RF-020) ---
# Sin SMTP_HOST los avisos quedan solo en la aplicación (campana de la interfaz).
SMTP_HOST=
SMTP_PUERTO=587
# starttls (587), ssl (465) o ninguna (solo para un servidor de pruebas local).
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
# Hora local a partir de la cual sale el resumen diario y desfase horario (Colombia: -5).
NOTIFICACIONES_HORA_RESUMEN=7
NOTIFICACIONES_UTC_OFFSET=-5
# Intentos de envío de un correo antes de dejar el aviso solo en la aplicación.
NOTIFICACIONES_MAX_INTENTOS=5
# Dirección de la interfaz para los enlaces de los correos.
WEBUI_URL=http://localhost:8080

# --- Informes inmutables (DA-06) ---
# Contenedor de Blob Storage con política de inmutabilidad (lo crea infra/terraform). Vacío: los
# informes quedan solo en INFORMES_DIR. Autentica con la identidad administrada (AZURE_CLIENT_ID).
ALMACEN_INFORMES_URL=

# --- Hora local ---
# Desfase respecto de UTC con que se muestran las fechas (Colombia: -5). La base guarda UTC.
UTC_OFFSET=-5

# --- Reglas de recomendación ---
# Solo para la versión 1 de las reglas del puntaje, que la API crea al arrancar si no existe.
# Después los umbrales se cambian en la pantalla "Reglas del puntaje" (RF-032, RF-033).
UMBRAL_OFERTAR=80
UMBRAL_REVISION=50

# --- Informes (PDF y versión texto) ---
INFORMES_DIR=data/informes

# --- Reservadas (el código aún no las usa) ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=informes
# Telemetría (RF-043): trazas y métricas de las cuatro unidades a Azure Monitor. Vacía = no exporta.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
