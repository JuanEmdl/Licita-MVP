# Plantilla de variables de entorno. Copiar a .env y rellenar.
# El archivo .env esta en .gitignore: NUNCA se sube al repositorio.
# En Azure, estos valores van como secretos de la Container App o en Key Vault,
# no en un archivo.

# --- Base de datos (DA-05: PostgreSQL con pgvector) ---
# Local (docker-compose):
DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/licitaciones
# Azure Database for PostgreSQL Flexible Server:
# DB_CONNECTION_STRING=postgresql://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/licitaciones?sslmode=require

# --- API ---
API_URL=http://localhost:8000

# --- Cola de trabajo (ASR-11) ---
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=analisis-licitaciones

# --- Modelo de lenguaje (agentes del worker de analisis) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Almacenamiento de informes inmutables (EP-05) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=informes

# --- Identidad (DA-10: OIDC) ---
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Observabilidad ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
